APP_NAME=QuestBoard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
# Port nginx publishes in docker compose
APP_PORT=8080

BCRYPT_ROUNDS=12

# "stack" for local files, "json" for structured logs on stderr (containers)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=questboard
DB_USERNAME=questboard
DB_PASSWORD=questboard
# Only used by docker compose for the MySQL container
DB_ROOT_PASSWORD=root

SESSION_DRIVER=array
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=qb-cache-

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=qb-

# Comma separated proxy IPs/CIDRs whose X-Forwarded-* headers are trusted
TRUSTED_PROXIES=127.0.0.1

# Allowed CORS origins (comma separated). Empty = no browser origins allowed.
CORS_ALLOWED_ORIGINS=

# --- QuestBoard -------------------------------------------------------------
QB_RISK_THRESHOLD=60
QB_DEFAULT_DAILY_XP_CAP=5000
QB_SIGNATURE_TOLERANCE=300
# Requests per minute (raise QB_RATE_LIMIT_API for load tests)
QB_RATE_LIMIT_API=120
QB_RATE_LIMIT_SERVER=1200
QB_RATE_LIMIT_GENERATE=5
# Allow http:// and private webhook targets (local development ONLY)
QB_WEBHOOKS_ALLOW_INSECURE=false

# Required in production: bearer token for GET /metrics
METRICS_TOKEN=

# --- LLM ----------------------------------------------------------------------
# "fake" works offline (default). "http" = any OpenAI-compatible Chat Completions API.
LLM_DRIVER=fake
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30
LLM_PRICE_IN=0.00015
LLM_PRICE_OUT=0.0006

# Demo seed data on `docker compose up` (true/false)
SEED_DEMO_DATA=true

MAIL_MAILER=log
